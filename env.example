# ===== MongoDB =====
MONGODB_URI=                                     # MongoDB connection string (required)

# ===== JWT =====
JWT_SECRET=                                      # JWT signing secret, min 32 characters (required)

# ===== Cloudinary (Image Upload) =====
CLOUDINARY_CLOUD_NAME=                           # Cloudinary cloud name for server-side operations
CLOUDINARY_API_KEY=                              # Cloudinary API key
CLOUDINARY_API_SECRET=                           # Cloudinary API secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=               # Cloudinary cloud name (public, used by client)

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=                                # Google OAuth client ID
GOOGLE_CLIENT_SECRET=                            # Google OAuth client secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=                    # Google OAuth client ID (public, used by client)

# ===== Email (SMTP) — Optional =====
# If not configured, password reset tokens are logged to console
EMAIL_HOST=                                      # SMTP host (e.g. smtp.gmail.com)
EMAIL_PORT=587                                   # SMTP port
EMAIL_SECURE=false                               # Use TLS (true for 465, false for 587)
EMAIL_USER=                                      # SMTP username/email
EMAIL_PASSWORD=                                  # SMTP password or app password
EMAIL_FROM=noreply@pantry.com                    # From address for outgoing emails

# ===== Stripe (Payments) =====
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=              # Stripe publishable key (public)
STRIPE_SECRET_KEY=                               # Stripe secret key (server-side)

# ===== App =====
NEXT_PUBLIC_APP_URL=http://localhost:3000         # Public URL of the app (used for links, sitemap, SEO)